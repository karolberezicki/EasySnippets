<ContentDialog
    x:Class="EasySnippets.Views.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Snippet Editor"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ContentDialog.CloseButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </ContentDialog.CloseButtonStyle>

    <Grid Width="300" Height="350" RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Name of snippet:"
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" x:Name="SnippetNameTextBox" FontSize="18"
                 PlaceholderText="Enter name..."/>

        <TextBlock Grid.Row="2" Text="Value of snippet:"
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   Margin="0,12,0,4"/>
        <TextBox Grid.Row="3" x:Name="SnippetValueTextBox"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 PlaceholderText="Enter value..."
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

        <Button Grid.Row="4" x:Name="DeleteButton"
                HorizontalAlignment="Left" Margin="0,12,0,0"
                Click="DeleteClick" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                <TextBlock Text="Delete"/>
            </StackPanel>
        </Button>
    </Grid>
</ContentDialog>
