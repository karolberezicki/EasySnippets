<Window
    x:Class="EasySnippets.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Easy Snippets">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid Margin="0" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0" Margin="4,4,4,0">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Open..." Click="MenuOpen_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Save" Click="MenuSave_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="S"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Save As..." Click="MenuSaveAs_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="S"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Exit" Click="Exit_Click"/>
            </MenuBarItem>
            <MenuBarItem Title="Tools">
                <ToggleMenuFlyoutItem x:Name="AlwaysOnTopMenuItem" Text="Always on top" Click="AlwaysOnTopToggle"/>
                <ToggleMenuFlyoutItem x:Name="AutoStartMenuItem" Text="Start with Windows" Click="AutoStartToggle"/>
                <ToggleMenuFlyoutItem x:Name="AutoSaveMenuItem" Text="Auto save" Click="AutoSaveToggle"/>
            </MenuBarItem>
            <MenuBarItem Title="+Add new">
                <MenuFlyoutItem Text="Add new snippet" Click="AddNewClick"/>
            </MenuBarItem>
        </MenuBar>

        <ListView Grid.Row="1" x:Name="SnippetsListView"
                  Margin="4,4,4,4"
                  Padding="2"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="SnippetsListView_ItemClick"
                  DoubleTapped="SnippetsListView_DoubleTapped">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,1,0,1"/>
                    <Setter Property="Padding" Value="12,8,12,8"/>
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontSize="18"
                               TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
